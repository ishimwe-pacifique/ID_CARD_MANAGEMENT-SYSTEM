# MongoDB Connection String (Atlas Cluster)
# If your password contains special characters like '@', make sure they are percent-encoded (e.g. @ -> %40)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.s2hzqcu.mongodb.net/student_id_db?retryWrites=true&w=majority
MONGODB_DB=student_id_db

# Cloudinary Configuration for Image/Photo Uploads
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>
